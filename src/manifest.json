{
  "manifest_version": 3,
  "name": "Monzonline Affiliate Tag Injector",
  "version": "1.1.0",
  "description": "Automatically injects Monzonline affiliate tags into Amazon URLs for supported countries.",
  "permissions": [
    "webNavigation"
  ],
  "icons": {
    "16": "favicons/favicon-16x16.png",
    "32": "favicons/favicon-32x32.png",
    "64": "favicons/favicon-64x64.png",
    "128": "favicons/favicon-128x128.png",
    "256": "favicons/favicon-256x256.png"
  },
  "host_permissions": [
    "*://amazon.de/*",
    "*://amazon.fr/*",
    "*://amazon.it/*",
    "*://amazon.es/*",
    "*://amazon.co.uk/*",
    "*://amazon.nl/*",
    "*://amazon.com.be/*",
    "*://amazon.pl/*",
    "*://amazon.se/*",
    "*://amazon.ie/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}